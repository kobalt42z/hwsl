# shellcheck shell=bash
# -----------------------------------------------------------------------------
# Golden image configuration. Single source of truth for build/ and post-init/.
#
# This file is baked into the image at /etc/golden-image/config.env, so
# harden.sh inside the distro uses exactly the values the image was built with.
# Override any value at build time with environment variables or with
#   build/build.sh --config my-site.env
# Values marked PLACEHOLDER must be set for your environment.
# -----------------------------------------------------------------------------

# Image version written to /etc/golden-image/version and used in the output
# file name: podman-wsl-golden-<GOLDEN_VERSION>.tar.zst
GOLDEN_VERSION="${GOLDEN_VERSION:-5.8.9-1}"

# <PODMAN_VERSION>: the Podman release the image is built and tested for.
# 5.8.9 is the latest 5.x release at the time of writing (Nov 2026); the
# provisioning analysis in docs/podman-provisioning.md is for this tag.
PODMAN_VERSION="${PODMAN_VERSION:-5.8.9}"

# <ARTIFACTORY_HOST>: registry host (and optional port) of Artifactory.
ARTIFACTORY_HOST="${ARTIFACTORY_HOST:-artifactory.example.com}"   # PLACEHOLDER

# Artifactory Docker remote repositories (repository keys). The resulting
# location is "<ARTIFACTORY_HOST>/<key>", e.g. artifactory.example.com/dockerhub-remote
ARTIFACTORY_REPO_DOCKERHUB="${ARTIFACTORY_REPO_DOCKERHUB:-dockerhub-remote}"
ARTIFACTORY_REPO_QUAY="${ARTIFACTORY_REPO_QUAY:-quay-remote}"
ARTIFACTORY_REPO_GHCR="${ARTIFACTORY_REPO_GHCR:-ghcr-remote}"
ARTIFACTORY_REPO_MCR="${ARTIFACTORY_REPO_MCR:-mcr-remote}"

# How public registries are handled:
#   redirect - docker.io/quay.io/ghcr.io/mcr.microsoft.com are rewritten to the
#              Artifactory remote repos. Image names stay unchanged, so
#              "FROM mcr.microsoft.com/dotnet/aspnet:8.0" in VS Dockerfiles keeps
#              working. (default, required for VS 2026 Docker tooling)
#   block    - the public registries are marked blocked=true and the short-name
#              aliases that point at docker.io are removed. Every image must be
#              referenced as <ARTIFACTORY_HOST>/<repo>/<image>.
REGISTRY_MODE="${REGISTRY_MODE:-redirect}"

# Base image: the official Podman machine OS artifact for this Podman version.
# Point this at the Artifactory remote repo that proxies quay.io so the build
# works without internet, e.g.
#   docker://artifactory.example.com/quay-remote/podman/machine-os:5.8
BASE_IMAGE_REF="${BASE_IMAGE_REF:-docker://quay.io/podman/machine-os:5.8}"
# Architecture of the WSL disk to select from the artifact index.
BASE_ARCH="${BASE_ARCH:-x86_64}"

# <CA_FILE>: corporate root CA (PEM). Path relative to the repo root or absolute.
CA_FILE="${CA_FILE:-}"                                              # PLACEHOLDER
CA_NAME="${CA_NAME:-corporate-root-ca}"

# <DNF_MIRROR>: base URL of the internal Fedora mirror. $releasever and
# $basearch are expanded by dnf, so keep them single-quoted.
DNF_MIRROR="${DNF_MIRROR:-https://artifactory.example.com/artifactory/fedora-remote}"  # PLACEHOLDER
DNF_REPO_FEDORA_PATH="${DNF_REPO_FEDORA_PATH:-/releases/\$releasever/Everything/\$basearch/os/}"
DNF_REPO_UPDATES_PATH="${DNF_REPO_UPDATES_PATH:-/updates/\$releasever/Everything/\$basearch/}"

# Packages removed from the image if installed. Removal is offline
# (--disablerepo='*') and protected by DNF_PROTECTED_PACKAGES; the build fails
# if anything Podman provisioning needs disappears.
REMOVE_PACKAGES="${REMOVE_PACKAGES:-nmap-ncat telnet wget wget2 wget2-wget tcpdump gdb strace ltrace git git-core gcc gcc-c++ make vim-enhanced nano emacs-nox}"
DNF_PROTECTED_PACKAGES="${DNF_PROTECTED_PACKAGES:-podman crun conmon containers-common openssh-server sudo shadow-utils util-linux util-linux-core procps-ng systemd coreutils grep sed gawk iptables-nft iptables-legacy rpm dnf dnf5 ca-certificates passt gvisor-tap-vsock gvisor-tap-vsock-gvforwarder}"

# <Edition>: Visual Studio 2026 edition folder (Community|Professional|Enterprise).
# Invoke-Harden.ps1 normally detects the real install path with vswhere and
# passes it with --vs-root, which wins over this value.
VS_EDITION="${VS_EDITION:-Enterprise}"                              # PLACEHOLDER
VS_MAJOR_FOLDER="${VS_MAJOR_FOLDER:-18}"

# Sub-folders of the VS install that the VS container tools bind-mount into
# containers (read-only). Confirm on a working debug session with
#   podman inspect <container> --format '{{json .Mounts}}'
# and adjust. Separated by ';' (paths contain spaces).
VS_RO_SUBPATHS="${VS_RO_SUBPATHS:-MSBuild\\Sdks\\Microsoft.Docker.Sdk\\tools;Common7\\IDE\\CommonExtensions\\Microsoft\\HotReload}"

# NuGet fallback folder that VS mounts at /.nuget/fallbackpackages (read-only).
NUGET_FALLBACK_PATH="${NUGET_FALLBACK_PATH:-C:\\Program Files (x86)\\Microsoft Visual Studio\\Shared\\NuGetPackages}"

# Default capabilities for containers (Podman's default list minus
# SETFCAP, SETPCAP and SYS_CHROOT).
DEFAULT_CAPABILITIES="${DEFAULT_CAPABILITIES:-CHOWN DAC_OVERRIDE FOWNER FSETID KILL NET_BIND_SERVICE SETGID SETUID}"

# CONFLICT SWITCHES - see README "Conflicts with Podman provisioning".
# [boot] systemd=true: Podman 5.x runs its own systemd in a nested PID
# namespace and detects "running" by looking for /lib/systemd/systemd. WSL's
# native systemd breaks that detection, so the default is false.
WSL_BOOT_SYSTEMD="${WSL_BOOT_SYSTEMD:-false}"
# Restrict sudo for "user" to the one command Podman's login path needs.
# false = keep Podman's "%wheel ALL=(ALL) NOPASSWD: ALL".
RESTRICT_SUDO="${RESTRICT_SUDO:-true}"
# Remove "user" from wheel. wheel owns the rootful Podman socket (0660) that
# Podman's socket drop-in creates, so membership is equivalent to root.
REMOVE_USER_FROM_WHEEL="${REMOVE_USER_FROM_WHEEL:-true}"

# The Linux account Podman creates (mc.SSH.RemoteUsername). Must stay "user".
MACHINE_USER="${MACHINE_USER:-user}"
MACHINE_UID="${MACHINE_UID:-1000}"
