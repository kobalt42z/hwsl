<!--
  PodmanGoldenImage.msi - per-machine package with the golden WSL image, the
  machine-wide Podman default-image config, the compliance tooling and the
  per-user scheduled compliance task. Built by installer/build-installer.ps1.

  Preprocessor variables (-d):
    Version        MSI version, 4 numeric parts (e.g. 5.8.9.1)
    PayloadDir     staging folder with the files below
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Podman WSL Golden Image" Manufacturer="Platform Engineering" Version="$(var.Version)"
           UpgradeCode="6f1f2a52-3c55-4d0e-9a1e-2b7c1a0e5d41" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <!-- The image is already zstd-compressed: store it as is. -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="none" MaximumUncompressedMediaSize="2000" />

    <util:QueryNativeMachine />
    <Launch Condition='WIX_NATIVE_MACHINE = 34404' Message="[ProductName] requires 64-bit (x64) Windows." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PodmanGoldenImage" />
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="IMAGEFOLDER" Name="PodmanGoldenImage" />
      <Directory Id="ContainersFolder" Name="containers">
        <Directory Id="CONFD" Name="containers.conf.d" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="Tools" Directory="INSTALLFOLDER">
      <Component>
        <File Source="$(var.PayloadDir)\Test-WslCompliance.ps1" KeyPath="yes" />
      </Component>
      <Component>
        <File Source="$(var.PayloadDir)\Invoke-Harden.ps1" KeyPath="yes" />
      </Component>
      <Component>
        <File Source="$(var.PayloadDir)\Register-GoldenImageTasks.ps1" KeyPath="yes" />
      </Component>
      <Component>
        <File Source="$(var.PayloadDir)\bundle-info.json" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Image" Directory="IMAGEFOLDER">
      <Component>
        <!-- Users may read the image, not replace it or add files next to it. -->
        <CreateFolder>
          <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
        </CreateFolder>
        <File Source="$(var.PayloadDir)\podman-wsl-golden.tar.zst" Name="podman-wsl-golden.tar.zst" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="PodmanConfig" Directory="CONFD">
      <Component>
        <!-- Machine-wide containers.conf drop-in, read by Podman for Windows from
             %ProgramData%\containers\containers.conf.d (containers/common
             config_windows.go). Makes a plain `podman machine init` use the golden
             image. Users may not add drop-ins here. -->
        <CreateFolder>
          <PermissionEx Sddl="O:BAG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
        </CreateFolder>
        <IniFile Id="DefaultProvider" Action="addLine" Directory="CONFD" Name="50-podman-golden-image.conf"
                 Section="machine" Key="provider" Value="&quot;wsl&quot;" />
        <!-- TOML literal string (single quotes): backslashes stay verbatim. -->
        <IniFile Id="DefaultImage" Action="addLine" Directory="CONFD" Name="50-podman-golden-image.conf"
                 Section="machine" Key="image" Value="'[IMAGEFOLDER]podman-wsl-golden.tar.zst'" />
        <RemoveFile Id="RemoveDropin" Directory="CONFD" Name="50-podman-golden-image.conf" On="uninstall" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\PodmanGoldenImage" Name="Version" Value="$(var.Version)"
                       Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\PodmanGoldenImage" Name="ImagePath"
                       Value="[IMAGEFOLDER]podman-wsl-golden.tar.zst" Type="string" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Podman WSL Golden Image" Level="1">
      <ComponentGroupRef Id="Tools" />
      <ComponentGroupRef Id="Image" />
      <ComponentGroupRef Id="PodmanConfig" />
    </Feature>

    <!-- Scheduled compliance task + event log source (as SYSTEM). -->
    <SetProperty Id="RegisterTasks" Sequence="execute" Before="RegisterTasks"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]Register-GoldenImageTasks.ps1&quot; -Action Install" />
    <CustomAction Id="RegisterTasks" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Return="check" Impersonate="no" />
    <SetProperty Id="UnregisterTasks" Sequence="execute" Before="UnregisterTasks"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]Register-GoldenImageTasks.ps1&quot; -Action Uninstall" />
    <CustomAction Id="UnregisterTasks" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Return="ignore" Impersonate="no" />
    <InstallExecuteSequence>
      <Custom Action="UnregisterTasks" Before="RemoveFiles" Condition='REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE' />
      <Custom Action="RegisterTasks" After="InstallFiles" Condition='NOT REMOVE~="ALL"' />
    </InstallExecuteSequence>
  </Package>
</Wix>
